{
  "input_dir": "data/raw",
  "curated_dir": "data/curated",
  "rejected_dir": "data/rejected",
  "graph_dir": "data/graph",
  "report_path": "output/summary_report.json",
  "html_report_path": "output/report.html",

  "supported_extensions": [".txt", ".md", ".json", ".docx", ".xlsx", ".csv", ".pdf"],
  "enable_pdf": true,

  "language": {
    "enabled": true,
    "allowed": ["en"],
    "min_confidence": 0.8
  },

  "chunking": {
    "enabled": true,
    "chunk_size": 150,
    "overlap": 20
  },

  "dedup": {
    "exact": true,
    "near_duplicate": true,
    "method": "minhash",
    "similarity_threshold": 0.85,
    "minhash_num_perm": 128
  },

  "quality": {
    "min_token_count": 20,
    "max_token_count": 50000,
    "min_avg_word_length": 3.0,
    "max_symbol_ratio": 0.3,
    "min_alpha_ratio": 0.5
  },

  "contamination": {
    "seed_terms": [
      "carbonated", "beverage", "soft drink", "drink", "juice",
      "packaging", "bottle", "PET", "carbon dioxide", "CO2",
      "sweetener", "sugar", "syrup", "flavour", "flavor",
      "preservative", "citric acid", "carbonation", "filling",
      "aseptic", "bottling", "ingredient", "food", "nutrition",
      "processing", "manufacturing", "formulation", "product",
      "water", "extract", "concentrate", "additive", "emulsifier"
    ],
    "min_relevance_score": 0.02
  },

  "graph": {
    "top_n_keywords": 25,
    "min_edge_weight": 2,
    "use_spacy_entities": true,
    "spacy_model": "en_core_web_sm",
    "use_bigrams": true,
    "community_detection": true,
    "pagerank_alpha": 0.85
  },

  "search": {
    "top_k": 5,
    "min_score": 0.05
  },

  "logging": {
    "level": "INFO",
    "log_file": "output/pipeline.log"
  }
}
